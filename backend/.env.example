# Copy to .env — never commit real keys. The app never talks to AI vendors directly; only this backend does.
PORT=8080
# Vision provider: stub (default, offline-safe — /api/diagnose returns a
# labeled demo response) or openai (GPT-4o vision when OPENAI_API_KEY is set).
# FIXIT_AI_PROVIDER is the canonical name; AI_PROVIDER is accepted as an alias.
FIXIT_AI_PROVIDER=stub
OPENAI_API_KEY=
# Model: gpt-4o is the default in code (FIXIT_AI_MODEL / OPENAI_MODEL override).
FIXIT_AI_MODEL=gpt-4o
# AI cost cap — monthly diagnosis allowance per device (defaults in code:
# preview 3, full 100). The owner sets the real numbers here.
FIXIT_PREVIEW_MONTHLY_LIMIT=3
FIXIT_FULL_MONTHLY_LIMIT=100
# Purchase verification via RevenueCat (server-side secret key only — the
# mobile app uses the separate public SDK keys in mobile/app.json extra).
# Without REVENUECAT_API_KEY, /api/purchases/verify returns 503 entitled:false.
REVENUECAT_API_KEY=
REVENUECAT_ENTITLEMENT_ID=
FIXIT_LIFETIME_SKU=fixit_lifetime_799

# Copy to .env — never commit real keys. The app never talks to AI vendors directly; only this backend does.
PORT=8080
# Vision/Reasoning provider: stub (default, offline-safe) or openai-compatible
AI_PROVIDER=stub
# When AI_PROVIDER=openai-compatible:
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Purchase verification (fill when wiring real store verification)
APPLE_SHARED_SECRET=
GOOGLE_SERVICE_ACCOUNT_JSON=
